    "About" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "О приложении"
          }
        }
      }
    },
    "about.espeak" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The eSpeak NG is a compact open source software text-to-speech synthesizer. It supports more than 100 languages and accents. It is based on the eSpeak engine created by Jonathan Duddington."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "eSpeak NG — это компактный синтезатор речи с открытым исходным кодом. Он поддерживает более 100 языков и акцентов. Он основан на движке eSpeak, созданном Джонатаном Даддингтоном."
          }
        }
      }
    },
    "about.espeak-app" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "eSpeak NG app is wrote by Yury Popov (@djphoenix). It is always free and open with respect for the blind people."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение eSpeak NG написано Юрием Поповым (@djphoenix). Оно всегда бесплатно и открыто с уважением к незрячим."
          }
        }
      }
    },
